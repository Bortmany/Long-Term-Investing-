# Copy this file to .env and fill in the values.

# PostgreSQL connection string.
DATABASE_URL="postgresql://investiq:investiq@localhost:5432/investiq"

# Secret used to sign auth sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""

# The URL the app runs at locally.
BETTER_AUTH_URL="http://localhost:3000"

# Financial Modeling Prep API key (free tier is fine).
# Leave empty: the app then uses manually entered / sample prices only.
FMP_API_KEY=""

# Anthropic API key for AI features (Phase 3+).
# Leave empty: AI features stay off, everything else works.
ANTHROPIC_API_KEY=""

# Whether new accounts can be created on /sign-up.
# Defaults to enabled; ONLY the literal string "false" disables it.
# Set to "false" before deploying anywhere public.
ALLOW_SIGNUPS="true"

# Scheduled weekly-review endpoint (/api/cron/weekly-review) — DEFERRED / off by
# default. Both must be set to enable it (otherwise the route returns 401/501):
#   CRON_SECRET   — bearer token the scheduler must send; any long random string.
#   CRON_USER_ID  — the user id whose portfolio the scheduled review runs for.
# See .github/workflows/weekly-review.yml.example (disabled by its .example suffix).
CRON_SECRET=""
CRON_USER_ID=""
