# Copy this file to .env and fill in the values.

# PostgreSQL connection string.
DATABASE_URL="postgresql://investiq:investiq@localhost:5432/investiq"

# Secret used to sign auth sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""

# The URL the app runs at locally.
BETTER_AUTH_URL="http://localhost:3000"

# Financial Modeling Prep API key (free tier is fine).
# Leave empty: the app then uses manually entered / sample prices only.
FMP_API_KEY=""

# Anthropic API key for AI features (Phase 3+).
# Leave empty: AI features stay off, everything else works.
ANTHROPIC_API_KEY=""

# Plans and billing. Payments are built but OFF. Billing is on only when
# BILLING_ENABLED is the literal "true" AND all four Stripe values below are
# set; anything less keeps it OFF (no upgrade buttons, the webhook answers 503
# "dormant"). A live key (sk_live_...) outside production also counts as OFF, so
# a test machine can never charge a real card. Never commit real keys. Do not
# turn this on until the payments checklist in GO-LIVE.md is done.
# Cap on NEW AI analyses across ALL users per UTC day. Default 100 when empty;
# "0" pauses AI for everyone. Per-user limits (Free 2 a day, Pro 10 a day and
# 150 a month) are fixed in src/lib/plans.ts.
GLOBAL_AI_DAILY_CAP=""
BILLING_ENABLED=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# The off-switch for new accounts on /sign-up. Sign-ups are OPEN by default.
# Set to the literal string "true" to pause them (the sign-up page says so and
# the server refuses sign-up attempts); sign-in, password reset and email
# confirmation keep working for people who already have an account. Restart
# the app after changing it.
# Note: in production, sign-ups are also refused automatically while email
# (RESEND_API_KEY + RESEND_FROM below) isn't set up, because new people
# couldn't confirm their address.
SIGNUPS_PAUSED=""

# Error tracking (Sentry). Leave empty to keep error tracking OFF (dormant):
# nothing is sent anywhere without these. SENTRY_DSN is used on the server,
# NEXT_PUBLIC_SENTRY_DSN in the browser. They are usually the same DSN value.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Shared rate-limit store (scaling seam). Leave empty: the app uses a fast
# in-memory limiter, so limits are counted PER SERVER PROCESS. Setting this is
# the future switch for a shared Redis-backed limiter across many instances.
REDIS_URL=""

# Whether to trust the X-Forwarded-For / X-Real-IP headers for a visitor's IP
# when rate-limiting sign-in / sign-up. These headers can be faked by anyone,
# so trusting them blindly lets an attacker rotate a fake IP per request and
# slip past the IP limit. Only set this to "true" when the app runs BEHIND a
# proxy you control that overwrites the header (e.g. Railway, a load balancer).
# Left empty/anything-else (the default), those headers are ignored: anonymous
# callers are instead limited by a stable id in a signed httpOnly cookie (one
# per browser), so a few requests can't lock sign-in for everyone — and the
# per-account limiter still stops brute force against one email. The app logs a
# one-line notice at startup when this is off, so the choice is deliberate.
TRUST_PROXY_HEADERS=""

# Secret shared by the scheduled cron endpoints: POST /api/cron/weekly-review
# and POST /api/cron/check-alerts. Leave empty: both endpoints answer
# "dormant" (503) and do nothing — scheduling stays off. Set a long random
# value to turn them on, then call either endpoint with header
# "Authorization: Bearer <this value>" (see weekly-review.yml.example and
# check-alerts.yml.example in .github/workflows/ for how to schedule those
# calls). Generate one the same way as BETTER_AUTH_SECRET above. Never share
# this value or commit it anywhere.
CRON_SECRET=""

# Weekly-brief email (Resend, https://resend.com). Leave EITHER of these
# empty and email stays off (dormant) — no network call is ever made, and
# nothing else about the app changes. Set both to turn on a short email each
# time a weekly review finishes, sent to the signed-in user's own address.
RESEND_API_KEY=""
# The "from" address your Resend account is verified to send as,
# e.g. "InvestIQ AI <reviews@yourdomain.com>".
RESEND_FROM=""

# Contact address shown on the public /privacy and /terms pages (as a
# mailto link). Optional: leave empty and the pages show the owner's own
# address, naeljam@hotmail.com. Set it to route questions to another inbox.
PRIVACY_CONTACT_EMAIL=""

# Password for the seeded demo login (owner@example.com), used only by
# `npx prisma db seed` on a LOCAL (non-production) database. There is NO
# default: the seed refuses to create the demo account unless you set a
# strong value here (at least 12 characters). The demo login is created with
# its email already confirmed. In production (NODE_ENV="production") the seed
# never creates a demo login and never asks for this — it only adds the
# shared sample prices and exchange rates.
SEED_DEMO_PASSWORD=""

# End-to-end tests only (`npm run test:e2e`). The tests create their own
# login, e2e-test@investiq.test, on your LOCAL database with this password
# (a local-only fallback is used when it's empty). The test setup refuses to
# run against any database that isn't on this machine. Never needed on a
# server.
E2E_TEST_PASSWORD=""
