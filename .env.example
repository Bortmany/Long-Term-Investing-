# Copy this file to .env and fill in the values.

# PostgreSQL connection string.
DATABASE_URL="postgresql://investiq:investiq@localhost:5432/investiq"

# Secret used to sign auth sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""

# The URL the app runs at locally.
BETTER_AUTH_URL="http://localhost:3000"

# Financial Modeling Prep API key (free tier is fine).
# Leave empty: the app then uses manually entered / sample prices only.
FMP_API_KEY=""

# Anthropic API key for AI features (Phase 3+).
# Leave empty: AI features stay off, everything else works.
ANTHROPIC_API_KEY=""

# Whether new accounts can be created on /sign-up.
# Defaults to enabled; ONLY the literal string "false" disables it.
# Set to "false" before deploying anywhere public.
ALLOW_SIGNUPS="true"

# Password for the seeded demo login (owner@example.com), used only by
# `npx prisma db seed`. There is NO default: the seed refuses to create the
# demo account unless you set a strong value here (at least 12 characters).
# Leave empty if you are not seeding the demo account.
SEED_DEMO_PASSWORD=""
