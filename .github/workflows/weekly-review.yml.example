# EXAMPLE ONLY — rename to weekly-review.yml and configure CRON_SECRET +
# CRON_USER_ID secrets to enable. Currently disabled; Phase 6 ships the
# manual "Run weekly review" button instead (see docs/BUILD-PLAN.md's Batch
# API deferral note).

name: Weekly portfolio review

on:
  schedule:
    # Every Monday at 06:00 UTC.
    - cron: "0 6 * * 1"
  # Lets the owner trigger it by hand from the Actions tab, once enabled.
  workflow_dispatch: {}

jobs:
  run-weekly-review:
    runs-on: ubuntu-latest
    steps:
      - name: Call the weekly-review cron endpoint
        run: |
          curl --fail --show-error \
            --request POST \
            --header "Authorization: Bearer ${{ secrets.CRON_SECRET }}" \
            "${{ secrets.APP_URL }}/api/cron/weekly-review"
